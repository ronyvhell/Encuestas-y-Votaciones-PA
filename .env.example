# Cadena de conexión de MongoDB.
# Local con el servidor en memoria: mongodb://127.0.0.1:27017/encuestas
# Producción (MongoDB Atlas): mongodb+srv://usuario:password@cluster.mongodb.net/encuestas
MONGODB_URI=mongodb://127.0.0.1:27017/encuestas

# Secreto de sesiones de Auth.js. Genera uno con: openssl rand -base64 32
AUTH_SECRET=reemplaza-por-un-secreto-de-64-caracteres
