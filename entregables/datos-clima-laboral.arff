@relation clima_y_comunicacion_laboral

% Diccionario de variables (texto original de la encuesta)
% area: ¿En qué área trabajas?
% antiguedad: ¿Cuánto tiempo llevas en la empresa?
% edad: ¿En qué rango de edad estás?
% modalidad: ¿Cuál es tu modalidad de trabajo?
% comunicacion: ¿Qué tan clara es la comunicación con tu jefe? (1 = nada clara, 5 = muy clara)
% reconocimiento: ¿Sientes que tu trabajo es reconocido? (1 = nunca, 5 = siempre)
% carga: ¿Qué tan sostenible es tu carga laboral? (1 = insostenible, 5 = muy sostenible)
% equipo: ¿Cómo describes el ambiente de tu equipo? (1 = malo, 5 = excelente)
% salario: ¿Qué tan satisfecho estás con tu salario? (1 = nada, 5 = totalmente)
% recomendaria: Recomendarías esta empresa como lugar para trabajar
% sigue: ¿Piensas seguir en la empresa el próximo año?
%
% Etiquetas sin acentos para que Weka las lea en cualquier configuracion
% area: "Tecnología" -> "Tecnologia"
% antiguedad: "Menos de 1 año" -> "Menos de 1 ano"
% antiguedad: "1 a 3 años" -> "1 a 3 anos"
% antiguedad: "3 a 5 años" -> "3 a 5 anos"
% antiguedad: "Más de 5 años" -> "Mas de 5 anos"
% edad: "46 o más" -> "46 o mas"
% modalidad: "Híbrida" -> "Hibrida"
% sigue: "Sí" -> "Si"

@attribute area {Operativa,Administrativa,'Talento humano',Comercial,Tecnologia}
@attribute antiguedad {'Menos de 1 ano','1 a 3 anos','3 a 5 anos','Mas de 5 anos'}
@attribute edad {'26 a 35','18 a 25','36 a 45','46 o mas'}
@attribute modalidad {Presencial,Hibrida,Remota}
@attribute comunicacion numeric
@attribute reconocimiento numeric
@attribute carga numeric
@attribute equipo numeric
@attribute salario numeric
@attribute recomendaria {false,true}
@attribute sigue {No,Si}

